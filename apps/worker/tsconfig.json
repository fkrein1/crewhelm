{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    // Exact-pinned Better Auth, OAuth Provider, Better Fetch, and Drizzle declarations
    // conflict with the Worker-only environment. AGENTS.md bounds this leaf-only exception.
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["control-plane-migrations/**/*.ts", "sql.d.ts", "src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/oauth/testkit.ts",
    "src/agent/admitted-runs/test-agent.ts",
    "src/worker-test-env.d.ts",
    "src/worker-test-entry.ts"
  ]
}
