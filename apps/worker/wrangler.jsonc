{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crewhelm",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "durable_objects": {
    "bindings": [
      {
        "name": "OWNER_CONTROL_PLANE",
