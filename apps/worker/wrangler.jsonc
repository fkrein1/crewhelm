{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crewhelm",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "crewhelm-development-auth",
      "database_id": "c58217fd-fe09-447b-b79c-5d63ed1cedc0",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OWNER_CONTROL_PLANE",
        "class_name": "OwnerControlPlane",
      },
    ],
  },
  "exports": {
    "OwnerControlPlane": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "10001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "MCP_RATE_LIMIT",
      "namespace_id": "10002",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://crewhelm.fkrein.workers.dev",
  },
  "triggers": {
    "crons": ["17 * * * *"],
  },
}
