{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crewhelm-site",
  "compatibility_date": "2026-07-29",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": false,
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "crewhelm.app",
      "custom_domain": true,
    },
  ],
}
