{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crewhelm-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/registry", "/api/registry/*", "/recipes", "/recipes/*"],
  },
  "services": [
    {
      "binding": "REGISTRY",
      "service": "crewhelm-registry",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "713769259cd84b92a8f208b3d08fd755",
    },
  ],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "crewhelm.app",
      "custom_domain": true,
    },
  ],
}
