---
import Seo from "../components/Seo.astro";
import type { JsonLd, SocialImage } from "../lib/seo";
import { CREWHELM_SITE } from "../lib/seo";
import globalStyles from "../styles/global.css?url";

interface Props {
  canonical?: string | URL | null;
  description?: string;
  index?: boolean;
  socialImage?: SocialImage | null;
  structuredData?: JsonLd | JsonLd[] | null;
  title?: string;
}

const {
  canonical,
  description = CREWHELM_SITE.description,
  index = true,
  socialImage = CREWHELM_SITE.socialImage,
  structuredData = null,
  title = CREWHELM_SITE.title,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {canonical} {description} {index} {socialImage} {structuredData} {title} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-light.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-light-32.png" sizes="32x32" type="image/png" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark-32.png" sizes="32x32" type="image/png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-light.png" sizes="180x180" media="(prefers-color-scheme: light)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-dark.png" sizes="180x180" media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href={globalStyles} />
  </head>
  <body>
    <a class="fixed top-3 left-4 z-20 -translate-y-[160%] bg-inverse px-3.5 py-2.5 text-inverse-foreground transition-transform duration-150 focus:translate-y-0" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
