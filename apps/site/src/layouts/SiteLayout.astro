---
import Seo from "../components/Seo.astro";
import type { JsonLd } from "../lib/seo";
import { CREWHELM_SITE } from "../lib/seo";
import { CREWHELM_THEME_STORAGE_KEY } from "../lib/theme";
import globalStyles from "../styles/global.css?url";

interface Props {
  canonical?: string | URL | null;
  description?: string;
  index?: boolean;
  structuredData?: JsonLd | JsonLd[] | null;
  title?: string;
}

const {
  canonical,
  description = CREWHELM_SITE.description,
  index = true,
  structuredData = null,
  title = CREWHELM_SITE.title,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {canonical} {description} {index} {structuredData} {title} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline define:vars={{ storageKey: CREWHELM_THEME_STORAGE_KEY }}>
      (() => {
        let theme;

        try {
          const savedTheme = localStorage.getItem(storageKey);
          if (savedTheme === "light" || savedTheme === "dark") theme = savedTheme;
        } catch {
          // Fall through to the system preference when storage is unavailable.
        }

        theme ??= window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#11151e" : "#f2f0e9");
      })();
    </script>
    <link rel="stylesheet" href={globalStyles} />
  </head>
  <body>
    <a class="fixed top-3 left-4 z-20 -translate-y-[160%] bg-inverse px-3.5 py-2.5 text-inverse-foreground transition-transform duration-150 focus:translate-y-0" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
