---
import {
  CREWHELM_SITE,
  serializeJsonLd,
  type JsonLd,
  type SocialImage,
} from "../lib/seo";

interface Props {
  canonical?: string | URL | null;
  description?: string;
  index?: boolean;
  socialImage?: SocialImage | null;
  structuredData?: JsonLd | JsonLd[] | null;
  title?: string;
}

const {
  canonical,
  description = CREWHELM_SITE.description,
  index = true,
  socialImage = CREWHELM_SITE.socialImage,
  structuredData = null,
  title = CREWHELM_SITE.title,
} = Astro.props;

const canonicalUrl = canonical === undefined
  ? index
    ? new URL(Astro.url.pathname, CREWHELM_SITE.url).toString()
    : null
  : canonical?.toString() ?? null;
const resolvedSocialImage = socialImage
  ? {
      ...socialImage,
      url: new URL(socialImage.url, CREWHELM_SITE.url).toString(),
    }
  : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={index ? "index, follow" : "noindex, follow"} />
<meta name="theme-color" content="#f2f0e9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#11151e" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
<link rel="sitemap" href="/sitemap-index.xml" />
{
  index && (
    <>
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content={CREWHELM_SITE.name} />
      <meta property="og:locale" content={CREWHELM_SITE.locale} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
      {
        resolvedSocialImage && (
          <>
            <meta property="og:image" content={resolvedSocialImage.url} />
            <meta property="og:image:type" content={resolvedSocialImage.mimeType} />
            <meta property="og:image:width" content={resolvedSocialImage.width.toString()} />
            <meta property="og:image:height" content={resolvedSocialImage.height.toString()} />
            <meta property="og:image:alt" content={resolvedSocialImage.alt} />
          </>
        )
      }
      <meta name="twitter:card" content={resolvedSocialImage ? "summary_large_image" : "summary"} />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      {
        resolvedSocialImage && (
          <>
            <meta name="twitter:image" content={resolvedSocialImage.url} />
            <meta name="twitter:image:alt" content={resolvedSocialImage.alt} />
          </>
        )
      }
    </>
  )
}
{
  index && structuredData && (
    <script type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
  )
}
