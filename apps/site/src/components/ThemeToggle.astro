---
import { CREWHELM_THEME_STORAGE_KEY } from "../lib/theme";
---

<button
  class="cursor-pointer border-0 border-b border-current bg-transparent py-2 font-[inherit] text-[.68rem] font-bold tracking-[.04em] text-foreground uppercase hover:text-primary"
  type="button"
  data-theme-toggle
  data-storage-key={CREWHELM_THEME_STORAGE_KEY}
  hidden
>
  Dark mode
</button>

<script>
  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const storageKey = button.dataset.storageKey;

    if (!storageKey) continue;

    const updateButton = () => {
      const isDark = root.dataset.theme === "dark";
      document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute(
        "content",
        isDark ? "#11151e" : "#f2f0e9",
      );
      button.setAttribute("aria-label", "Use dark theme");
      button.setAttribute("aria-pressed", String(isDark));
    };

    button.hidden = false;
    updateButton();

    button.addEventListener("click", () => {
      const theme = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = theme;

      try {
        localStorage.setItem(storageKey, theme);
      } catch {
        // The selected theme still applies for this page when storage is unavailable.
      }

      updateButton();
    });

    media.addEventListener("change", (event) => {
      try {
        if (localStorage.getItem(storageKey)) return;
      } catch {
        return;
      }

      root.dataset.theme = event.matches ? "dark" : "light";
      updateButton();
    });
  }
</script>
