---
import type { RecipePreview } from "../../lib/recipe-catalog";
import RecipeDetail from "./RecipeDetail.astro";

interface Props {
  basePath: string;
  recipes: readonly RecipePreview[];
}

const { basePath, recipes } = Astro.props;
---

<div class="recipe-explorer" data-recipe-explorer data-base-path={basePath}>
  <slot />

  {
    recipes.map((recipe) => (
      <template data-recipe-template={recipe.slug}>
        <RecipeDetail recipe={recipe} mode="dialog" />
      </template>
    ))
  }

  <dialog class="recipe-dialog" data-recipe-dialog aria-modal="true">
    <div class="dialog-frame" data-dialog-frame>
      <div class="dialog-toolbar">
        <button type="button" data-dialog-close aria-label="Close recipe and return to the list">
          <span aria-hidden="true">←</span> Back to Recipes
        </button>
        <span>Esc</span>
      </div>
      <div data-dialog-content></div>
    </div>
  </dialog>
</div>

<script>
  interface RecipeDialogState {
    basePath: string;
    recipeDialog: true;
    slug: string;
  }

  interface ViewTransitionDocument extends Document {
    startViewTransition?: (update: () => void) => { finished: Promise<void> };
  }

  function setupRecipeExplorer(root: HTMLElement): void {
    if (root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const basePath = root.dataset.basePath;
    const dialog = root.querySelector<HTMLDialogElement>("[data-recipe-dialog]");
    const frame = root.querySelector<HTMLElement>("[data-dialog-frame]");
    const content = root.querySelector<HTMLElement>("[data-dialog-content]");
    const closeButton = root.querySelector<HTMLButtonElement>("[data-dialog-close]");
    if (!basePath || !dialog || !frame || !content || !closeButton) return;

    let activeSlug: string | null = null;
    let returnTarget: HTMLElement | null = null;

    const templateFor = (slug: string) =>
      root.querySelector<HTMLTemplateElement>(`template[data-recipe-template="${CSS.escape(slug)}"]`);
    const cardFor = (slug: string) =>
      root.querySelector<HTMLElement>(`[data-recipe-open][data-recipe-slug="${CSS.escape(slug)}"]`);
    const transition = (update: () => void) => {
      const transitionDocument = document as ViewTransitionDocument;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        update();
        return Promise.resolve();
      }
      if (!transitionDocument.startViewTransition) {
        update();
        return Promise.resolve();
      }
      document.documentElement.style.setProperty("view-transition-name", "none");
      const viewTransition = transitionDocument.startViewTransition(update);
      return viewTransition.finished.finally(() => {
        document.documentElement.style.removeProperty("view-transition-name");
      });
    };

    const render = (slug: string) => {
      const template = templateFor(slug);
      if (!template) return false;
      content.replaceChildren(template.content.cloneNode(true));
      dialog.setAttribute("aria-labelledby", `recipe-title-${slug}`);
      activeSlug = slug;
      return true;
    };

    const open = async (slug: string, source?: HTMLElement | null) => {
      if (!templateFor(slug)) return;
      returnTarget = source ?? cardFor(slug) ?? returnTarget;
      await transition(() => {
        frame.style.setProperty("view-transition-name", "recipe-dialog");
        if (!render(slug)) return;
        if (!dialog.open) dialog.showModal();
        document.documentElement.dataset.recipeDialogOpen = "true";
      });
      frame.style.removeProperty("view-transition-name");
      closeButton.focus({ preventScroll: true });
    };

    const close = async (restoreFocus = true) => {
      if (!dialog.open) return;
      const card = activeSlug ? cardFor(activeSlug) : null;
      frame.style.setProperty("view-transition-name", "recipe-dialog");
      await transition(() => {
        frame.style.removeProperty("view-transition-name");
        dialog.close();
        document.documentElement.removeAttribute("data-recipe-dialog-open");
        activeSlug = null;
      });
      if (restoreFocus) (returnTarget ?? card)?.focus({ preventScroll: true });
    };

    root.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const link = target.closest<HTMLAnchorElement>("[data-recipe-open]");
      if (!link || event.defaultPrevented || event instanceof MouseEvent && event.button !== 0) return;
      if (event instanceof MouseEvent && (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)) return;
      const slug = link.dataset.recipeSlug;
      if (!slug) return;
      event.preventDefault();
      const state: RecipeDialogState = { basePath, recipeDialog: true, slug };
      history.pushState(state, "", link.href);
      void open(slug, link);
    });

    closeButton.addEventListener("click", () => history.back());
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      history.back();
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) history.back();
    });
    window.addEventListener("popstate", (event) => {
      const state = event.state as Partial<RecipeDialogState> | null;
      if (state?.recipeDialog === true && state.basePath === basePath && state.slug) {
        void open(state.slug, cardFor(state.slug));
      } else {
        void close();
      }
    });
  }

  document.querySelectorAll<HTMLElement>("[data-recipe-explorer]").forEach(setupRecipeExplorer);
</script>

<style is:global>
  html[data-recipe-dialog-open="true"] {
    overflow: hidden;
  }

  .recipe-dialog {
    width: min(1120px, calc(100vw - 3rem));
    max-width: none;
    max-height: calc(100dvh - 3rem);
    margin: auto;
    border: 1px solid var(--border-strong);
    padding: 0;
    background: var(--background);
    color: var(--foreground);
    box-shadow: 18px 20px 0 color-mix(in oklch, var(--primary) 75%, transparent);
  }

  .recipe-dialog::backdrop {
    background: color-mix(in oklch, var(--color-ink-950) 78%, transparent);
    backdrop-filter: blur(6px);
  }

  .dialog-frame {
    overflow: auto;
    max-height: calc(100dvh - 3rem);
  }

  .dialog-toolbar {
    position: sticky;
    z-index: 10;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-strong);
    background: color-mix(in oklch, var(--background) 94%, transparent);
    padding: 0.65rem 0.85rem;
    backdrop-filter: blur(12px);
  }

  .dialog-toolbar button {
    border: 0;
    background: transparent;
    padding: 0.45rem;
    color: inherit;
    font: 800 0.72rem/1 var(--font-sans);
    cursor: pointer;
  }

  .dialog-toolbar > span {
    color: var(--muted-foreground);
    font: 0.62rem/1 var(--font-mono);
    text-transform: uppercase;
  }

  ::view-transition-group(recipe-dialog) {
    animation-duration: 260ms;
    animation-timing-function: cubic-bezier(0.2, 0, 0, 1);
  }

  ::view-transition-new(recipe-dialog):only-child {
    animation: 260ms cubic-bezier(0.2, 0, 0, 1) both recipe-dialog-in;
  }

  ::view-transition-old(recipe-dialog):only-child {
    animation: 180ms cubic-bezier(0.4, 0, 1, 1) both recipe-dialog-out;
  }

  @keyframes recipe-dialog-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.99);
    }
  }

  @keyframes recipe-dialog-out {
    to {
      opacity: 0;
      transform: translateY(8px) scale(0.995);
    }
  }

  @media (max-width: 620px) {
    .recipe-dialog {
      width: 100vw;
      max-height: 100dvh;
      border-inline: 0;
      box-shadow: none;
    }

    .dialog-frame {
      max-height: 100dvh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation-duration: 0.01ms !important;
    }
  }
</style>
