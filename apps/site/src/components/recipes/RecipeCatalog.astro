---
import {
  getRecipeChoiceSignals,
  getRecipeCardModelLabel,
  getRecipeModelLabel,
  type RecipePreview,
} from "../../lib/recipe-catalog";
import ConnectionLogo from "./ConnectionLogo.astro";

interface Props {
  recipes: readonly RecipePreview[];
  unavailable?: boolean;
}

const { recipes, unavailable = false } = Astro.props;

const choices = recipes.map((recipe) => {
  const signalSelection = getRecipeChoiceSignals(recipe);
  const modelLabel = getRecipeModelLabel(recipe.inference.primaryModel);
  return {
    cardModelLabel: getRecipeCardModelLabel(modelLabel),
    initialHiddenCount:
      signalSelection.hiddenCount +
      signalSelection.integrations.length +
      signalSelection.signals.length,
    modelLabel,
    recipe,
    signalSelection,
  };
});
---

<section class="choice-board shell" aria-labelledby="recipe-choice-title">
  <header class="board-header">
    <div class="title-block">
      <p class="eyebrow">Ready-made mandates</p>
      <h1 id="recipe-choice-title">Choose what fits.</h1>
    </div>
    <p class="intro">
      Start with the outcome you need. Each Recipe defines the work, what it uses, and the
      boundaries it keeps.
    </p>
  </header>

  <ul class="choice-grid">
    {
      choices.map(({ cardModelLabel, initialHiddenCount, modelLabel, recipe, signalSelection }) => (
        <li class="choice-item">
          <a
            class="recipe-card"
            data-recipe-open
            data-recipe-slug={recipe.slug}
            href={recipe.route}
          >
            <h3>{recipe.title}</h3>
            <p class="card-outcome">{recipe.summary}</p>

            <div
              class="metadata-line"
              data-base-hidden-count={signalSelection.hiddenCount}
              data-recipe-metadata
              aria-label={`Primary model: ${modelLabel}${
                signalSelection.accessibleLabel ? `. Features: ${signalSelection.accessibleLabel}` : ""
              }`}
            >
              {signalSelection.integrations.length > 0 && (
                <span
                  class="metadata-item metadata-item--integration"
                  data-count={signalSelection.integrations.length}
                  data-logo-item
                  data-metadata-item
                  hidden
                >
                  <span class="integration-block" aria-hidden="true">
                    {signalSelection.integrations.map((integration) => (
                      <ConnectionLogo integration={integration} loading="eager" size={15} />
                    ))}
                  </span>
                  <span class="metadata-separator" aria-hidden="true">•</span>
                </span>
              )}
              <strong data-metadata-fixed title={modelLabel}>{cardModelLabel}</strong>
              {signalSelection.signals.map((signal) => (
                <span
                  class="metadata-item"
                  data-count="1"
                  data-metadata-item
                  hidden
                >
                  <span class="metadata-separator" aria-hidden="true">•</span>
                  <span class:list={["signal", `signal--${signal.kind}`]}>{signal.label}</span>
                </span>
              ))}
              {initialHiddenCount > 0 && (
                <span class="metadata-overflow" data-metadata-overflow>
                  <span class="metadata-separator" aria-hidden="true">•</span>
                  <span class="more-signals" data-metadata-overflow-count>
                    +{initialHiddenCount}
                  </span>
                </span>
              )}
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  {
    recipes.length === 0 && (
      <div class="catalog-state" role={unavailable ? "alert" : "status"}>
        <h2>{unavailable ? "The Recipe Registry is temporarily unavailable." : "No Recipes have been published yet."}</h2>
        <p>{unavailable ? "Try this page again shortly." : "Published Recipes will appear here automatically."}</p>
      </div>
    )
  }
</section>

<script>
  import { fitRecipeMetadataItems } from "../../lib/recipe-catalog";

  function positiveInteger(value: string | undefined): number {
    const parsed = Number(value);
    return Number.isInteger(parsed) && parsed > 0 ? parsed : 0;
  }

  interface PreparedMetadataLine {
    allItems: HTMLElement[];
    baseHiddenCount: number;
    candidates: HTMLElement[];
    fixed: HTMLElement;
    line: HTMLElement;
    overflow: HTMLElement;
    overflowCount: HTMLElement;
  }

  function prepareMetadataLine(line: HTMLElement): PreparedMetadataLine | null {
    const fixed = line.querySelector<HTMLElement>("[data-metadata-fixed]");
    const overflow = line.querySelector<HTMLElement>("[data-metadata-overflow]");
    const overflowCount = line.querySelector<HTMLElement>("[data-metadata-overflow-count]");
    if (fixed === null || overflow === null || overflowCount === null) return null;

    const allItems = Array.from(line.querySelectorAll<HTMLElement>("[data-metadata-item]"));
    let baseHiddenCount = positiveInteger(line.dataset.baseHiddenCount);
    const candidates = allItems.filter((item) => {
      const count = positiveInteger(item.dataset.count);
      const logoAvailable =
        item.dataset.logoItem === undefined ||
        item.querySelector(".connection-logo.is-loaded") !== null;
      if (!logoAvailable) baseHiddenCount += count;
      return logoAvailable;
    });
    const totalHiddenCount =
      baseHiddenCount +
      candidates.reduce((count, item) => count + positiveInteger(item.dataset.count), 0);

    line.dataset.measuring = "";
    for (const item of candidates) item.hidden = false;
    overflow.hidden = false;
    overflowCount.textContent = `+${String(totalHiddenCount)}`;
    return { allItems, baseHiddenCount, candidates, fixed, line, overflow, overflowCount };
  }

  function fitMetadataLines(lines: readonly HTMLElement[]): void {
    const prepared = lines
      .map(prepareMetadataLine)
      .filter((line): line is PreparedMetadataLine => line !== null);
    const measured = prepared.map((item) => ({
      fit: fitRecipeMetadataItems({
        availableWidth: item.line.clientWidth,
        baseHiddenCount: item.baseHiddenCount,
        fixedWidth: item.fixed.getBoundingClientRect().width,
        gapWidth: Number.parseFloat(getComputedStyle(item.line).columnGap) || 0,
        items: item.candidates.map((candidate) => ({
          count: positiveInteger(candidate.dataset.count),
          width: candidate.getBoundingClientRect().width,
        })),
        overflowWidth: item.overflow.getBoundingClientRect().width,
      }),
      item,
    }));

    for (const { fit, item } of measured) {
      delete item.line.dataset.measuring;
      for (const candidate of item.allItems) candidate.hidden = true;
      item.candidates.forEach((candidate, index) => {
        candidate.hidden = index >= fit.visibleItems;
      });
      item.overflowCount.textContent = `+${String(fit.hiddenCount)}`;
      item.overflow.hidden = fit.hiddenCount === 0;
    }
  }

  const metadataLines = Array.from(
    document.querySelectorAll<HTMLElement>("[data-recipe-metadata]"),
  );
  const pendingLines = new Set<HTMLElement>();
  let pendingFrame: number | undefined;
  const queueMetadataLines = (lines: readonly HTMLElement[]) => {
    for (const line of lines) pendingLines.add(line);
    if (pendingFrame !== undefined) return;
    pendingFrame = requestAnimationFrame(() => {
      pendingFrame = undefined;
      const batch = Array.from(pendingLines);
      pendingLines.clear();
      fitMetadataLines(batch);
    });
  };
  const resizeObserver = new ResizeObserver((entries) => {
    queueMetadataLines(entries.map((entry) => entry.target as HTMLElement));
  });
  metadataLines.forEach((line) => resizeObserver.observe(line));
  document.addEventListener("connection-logo-state", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const line = target.closest<HTMLElement>("[data-recipe-metadata]");
    if (line !== null) queueMetadataLines([line]);
  });
  void document.fonts?.ready.then(() => queueMetadataLines(metadataLines));
  queueMetadataLines(metadataLines);
</script>

<style>
  .choice-board {
    --choice-paper: var(--color-paper-50);
    --choice-ink: var(--color-ink-950);
    --choice-muted: var(--color-ink-600);
    --choice-line: color-mix(in oklch, var(--choice-ink) 16%, transparent);
    --choice-blue: var(--color-signal-600);
    color: var(--choice-ink);
  }

  .board-header {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
    padding: clamp(1.75rem, 3vw, 3rem) 0;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--choice-blue);
    font-size: 0.65rem;
    font-weight: 800;
  }

  h1 {
    max-width: none;
    margin: 0;
    color: var(--foreground);
    font-size: clamp(2.8rem, 4.8vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .intro {
    max-width: 38ch;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .choice-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.25vw, 1.25rem);
    margin: 0;
    padding: clamp(1.25rem, 2vw, 1.75rem) 0 clamp(2.5rem, 6vw, 6rem);
    list-style: none;
  }

  .catalog-state {
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 clamp(3rem, 7vw, 7rem);
    border: 1px solid var(--choice-line);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    background: var(--choice-paper);
  }

  .catalog-state h2 { margin: 0; font-size: clamp(1.35rem, 2vw, 2rem); }
  .catalog-state p { margin: 0.5rem 0 0; color: var(--choice-muted); }

  .choice-item {
    min-width: 0;
  }

  .recipe-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: clamp(0.95rem, 1.25vw, 1.15rem);
    color: var(--choice-ink);
    background: var(--choice-paper);
    border: 1px solid var(--choice-line);
    border-radius: 0.3rem;
    box-shadow: 0 0 0 0 var(--choice-blue);
    text-decoration: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .recipe-card:hover {
    border-color: var(--choice-ink);
    box-shadow: 5px 5px 0 color-mix(in oklch, var(--choice-blue) 78%, transparent);
    transform: translate(-2px, -2px);
  }

  .recipe-card:focus-visible {
    outline: 3px solid var(--choice-blue);
    outline-offset: 4px;
  }

  h3 {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: clamp(1.15rem, 1.45vw, 1.45rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-outcome {
    display: -webkit-box;
    max-width: 39ch;
    margin: 0.55rem 0 0;
    overflow: hidden;
    color: var(--choice-muted);
    font-size: 0.76rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .metadata-line {
    display: flex;
    min-width: 0;
    gap: 0.45rem;
    align-items: center;
    margin-top: auto;
    padding-top: 0.8rem;
    overflow: hidden;
    white-space: nowrap;
  }

  .metadata-line strong {
    flex: 0 0 auto;
    color: var(--choice-muted);
    font: 750 0.625rem/1.2 var(--font-mono);
  }

  .metadata-separator {
    flex: 0 0 auto;
    color: var(--choice-muted);
    font-size: 0.42rem;
    line-height: 1;
  }

  .metadata-item,
  .metadata-overflow {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.45rem;
    align-items: center;
  }

  .metadata-line[data-measuring] .metadata-item,
  .metadata-line[data-measuring] .metadata-overflow {
    position: absolute;
    display: inline-flex !important;
    visibility: hidden;
  }

  .integration-block {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.2rem;
    align-items: center;
  }

  .signal,
  .more-signals {
    flex: 0 0 auto;
    color: var(--choice-muted);
    font: 750 0.625rem/1.2 var(--font-mono);
    letter-spacing: 0;
  }

  .signal {
    white-space: nowrap;
  }

  @media (max-width: 75rem) {
    .choice-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 52rem) {
    .board-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .choice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .choice-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recipe-card {
      transition: none;
    }

    .recipe-card:hover {
      transform: none;
    }
  }
</style>
