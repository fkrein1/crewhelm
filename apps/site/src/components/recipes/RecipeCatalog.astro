---
import {
  getRecipeChoiceSignals,
  getRecipeModelLabel,
  type RecipePreview,
} from "../../lib/recipe-catalog";
import ConnectionLogo from "./ConnectionLogo.astro";

interface Props {
  recipes: readonly RecipePreview[];
  unavailable?: boolean;
}

const { recipes, unavailable = false } = Astro.props;

const choices = recipes.map((recipe) => ({
  modelLabel: getRecipeModelLabel(recipe.inference.primaryModel),
  recipe,
  signalSelection: getRecipeChoiceSignals(recipe),
}));
---

<section class="choice-board shell" aria-labelledby="recipe-choice-title">
  <header class="board-header">
    <div class="title-block">
      <p class="eyebrow">Ready-made mandates</p>
      <h1 id="recipe-choice-title">Choose what fits.</h1>
    </div>
    <p class="intro">
      Start with the outcome you need. Each Recipe defines the work, what it uses, and the
      boundaries it keeps.
    </p>
  </header>

  <ul class="choice-grid">
    {
      choices.map(({ modelLabel, recipe, signalSelection }) => (
        <li class="choice-item">
          <a
            class="recipe-card"
            data-recipe-open
            data-recipe-slug={recipe.slug}
            href={recipe.route}
          >
            <h3>{recipe.title}</h3>
            <p class="card-outcome">{recipe.summary}</p>

            <div
              class="metadata-line"
              aria-label={`Primary model: ${modelLabel}${
                signalSelection.accessibleLabel ? `. Features: ${signalSelection.accessibleLabel}` : ""
              }`}
            >
              {signalSelection.integrations.length > 0 && (
                <>
                  <span class="integration-block" aria-hidden="true">
                    {signalSelection.integrations.map((integration) => (
                      <ConnectionLogo integration={integration} size={15} />
                    ))}
                  </span>
                  <span class="metadata-separator" aria-hidden="true">•</span>
                </>
              )}
              <strong>{modelLabel}</strong>
              {signalSelection.signals.map((signal) => (
                <>
                  <span class="metadata-separator" aria-hidden="true">•</span>
                  <span class:list={["signal", `signal--${signal.kind}`]}>{signal.label}</span>
                </>
              ))}
              {signalSelection.hiddenCount > 0 && (
                <>
                  <span class="metadata-separator" aria-hidden="true">•</span>
                  <span class="more-signals">+{signalSelection.hiddenCount}</span>
                </>
              )}
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  {
    recipes.length === 0 && (
      <div class="catalog-state" role={unavailable ? "alert" : "status"}>
        <h2>{unavailable ? "The Recipe Registry is temporarily unavailable." : "No Recipes have been published yet."}</h2>
        <p>{unavailable ? "Try this page again shortly." : "Published Recipes will appear here automatically."}</p>
      </div>
    )
  }
</section>

<style>
  .choice-board {
    --choice-paper: var(--color-paper-50);
    --choice-ink: var(--color-ink-950);
    --choice-muted: var(--color-ink-600);
    --choice-line: color-mix(in oklch, var(--choice-ink) 16%, transparent);
    --choice-blue: var(--color-signal-600);
    color: var(--choice-ink);
  }

  .board-header {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(17rem, 0.75fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
    padding: clamp(1.75rem, 3vw, 3rem) 0;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--choice-blue);
    font-size: 0.65rem;
    font-weight: 800;
  }

  h1 {
    max-width: none;
    margin: 0;
    color: var(--foreground);
    font-size: clamp(2.8rem, 4.8vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .intro {
    max-width: 38ch;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.96rem;
    line-height: 1.65;
  }

  .choice-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.25vw, 1.25rem);
    margin: 0;
    padding: clamp(1.25rem, 2vw, 1.75rem) 0 clamp(2.5rem, 6vw, 6rem);
    list-style: none;
  }

  .catalog-state {
    margin: clamp(1.25rem, 2vw, 1.75rem) 0 clamp(3rem, 7vw, 7rem);
    border: 1px solid var(--choice-line);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    background: var(--choice-paper);
  }

  .catalog-state h2 { margin: 0; font-size: clamp(1.35rem, 2vw, 2rem); }
  .catalog-state p { margin: 0.5rem 0 0; color: var(--choice-muted); }

  .choice-item {
    min-width: 0;
  }

  .recipe-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: clamp(0.95rem, 1.25vw, 1.15rem);
    color: var(--choice-ink);
    background: var(--choice-paper);
    border: 1px solid var(--choice-line);
    border-radius: 0.3rem;
    box-shadow: 0 0 0 0 var(--choice-blue);
    text-decoration: none;
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .recipe-card:hover {
    border-color: var(--choice-ink);
    box-shadow: 5px 5px 0 color-mix(in oklch, var(--choice-blue) 78%, transparent);
    transform: translate(-2px, -2px);
  }

  .recipe-card:focus-visible {
    outline: 3px solid var(--choice-blue);
    outline-offset: 4px;
  }

  h3 {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    font-size: clamp(1.15rem, 1.45vw, 1.45rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .card-outcome {
    display: -webkit-box;
    max-width: 39ch;
    margin: 0.55rem 0 0;
    overflow: hidden;
    color: var(--choice-muted);
    font-size: 0.76rem;
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .metadata-line {
    display: flex;
    min-width: 0;
    gap: 0.45rem;
    align-items: center;
    margin-top: auto;
    padding-top: 0.8rem;
    overflow: hidden;
    white-space: nowrap;
  }

  .metadata-line strong {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    color: var(--choice-muted);
    font: 750 0.625rem/1.2 var(--font-mono);
    text-overflow: ellipsis;
  }

  .metadata-separator {
    flex: 0 0 auto;
    color: var(--choice-muted);
    font-size: 0.42rem;
    line-height: 1;
  }

  .integration-block {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.2rem;
    align-items: center;
  }

  .signal,
  .more-signals {
    flex: 0 0 auto;
    color: var(--choice-muted);
    font: 750 0.625rem/1.2 var(--font-mono);
    letter-spacing: 0;
  }

  .signal {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 75rem) {
    .choice-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 52rem) {
    .board-header {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .choice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .choice-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .recipe-card {
      transition: none;
    }

    .recipe-card:hover {
      transform: none;
    }
  }
</style>
