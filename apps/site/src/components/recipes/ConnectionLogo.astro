---
import {
  getComposioLogoUrl,
  type RecipeIntegration,
} from "../../lib/recipe-catalog";

interface Props {
  integration: RecipeIntegration;
  loading?: "eager" | "lazy";
  size?: number;
}

const { integration, loading = "lazy", size = 18 } = Astro.props;
const logoUrl = getComposioLogoUrl(integration.slug);
---

<span
  class="connection-logo"
  role="img"
  aria-label={`${integration.label} connection`}
  style={`--connection-logo-size:${String(size)}px`}
  title={integration.label}
>
  <img
    alt=""
    aria-hidden="true"
    decoding="async"
    loading={loading}
    referrerpolicy="no-referrer"
    src={logoUrl}
  />
</span>

<script>
  function initializeConnectionLogos(root: ParentNode): void {
    for (const image of root.querySelectorAll<HTMLImageElement>(".connection-logo img")) {
      if (image.dataset.logoInitialized !== undefined) continue;
      image.dataset.logoInitialized = "";
      const logo = image.closest<HTMLElement>(".connection-logo");
      const settle = () => {
        const available = image.naturalWidth > 0;
        logo?.classList.toggle("is-loaded", available);
        logo?.classList.toggle("is-unavailable", !available);
        logo?.dispatchEvent(new CustomEvent("connection-logo-state", { bubbles: true }));
      };
      image.addEventListener("load", settle, { once: true });
      image.addEventListener("error", settle, { once: true });
      if (image.complete) settle();
    }
  }

  document.addEventListener("connection-logos-initialize", (event) => {
    if (event.target instanceof Element) initializeConnectionLogos(event.target);
  });
  initializeConnectionLogos(document);
</script>

<style>
  .connection-logo {
    position: relative;
    display: inline-grid;
    width: var(--connection-logo-size);
    height: var(--connection-logo-size);
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    visibility: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .connection-logo.is-loaded {
    visibility: visible;
  }

  .connection-logo.is-unavailable {
    display: none;
  }
</style>
