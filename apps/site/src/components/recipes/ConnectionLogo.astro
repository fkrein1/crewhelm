---
import type { RecipeIntegration } from "../../lib/recipe-catalog";

interface Props {
  integration: RecipeIntegration;
  size?: number;
}

const { integration, size = 18 } = Astro.props;
const icons: Readonly<Record<string, { body: string; height?: number; width?: number }>> = {
  github: {
    body: '<path fill="currentColor" d="M128 0C57.3 0 0 57.3 0 128c0 56.6 36.7 104.5 87.5 121.5c6.4 1.2 8.8-2.8 8.8-6.2c0-3.1-.1-13.1-.2-23.8c-35.6 7.7-43.1-15.1-43.1-15.1c-5.8-14.8-14.2-18.7-14.2-18.7c-11.6-7.9.9-7.8.9-7.8c12.9.9 19.6 13.2 19.6 13.2c11.4 19.6 29.9 13.9 37.2 10.6c1.1-8.3 4.5-13.9 8.1-17.1c-28.4-3.2-58.3-14.2-58.3-63.3c0-14 5-25.4 13.2-34.4c-1.3-3.2-5.7-16.2 1.2-33.9c0 0 10.7-3.4 35.2 13.1a128 128 0 0 1 64.1 0c24.4-16.6 35.2-13.1 35.2-13.1c7 17.6 2.6 30.7 1.3 33.9c8.2 9 13.2 20.4 13.2 34.4c0 49.2-29.9 60-58.4 63.2c4.6 4 8.7 11.8 8.7 23.7c0 17.1-.1 30.9-.1 35.1c0 3.4 2.3 7.4 8.8 6.1C219.4 232.5 256 184.5 256 128C256 57.3 198.7 0 128 0"/>',
  },
  googlecalendar: {
    body: '<path fill="#fff" d="M60.6 60.6h134.8v134.8H60.6z"/><path fill="#ea4335" d="M195.4 256l60.6-60.6l-60.6-10.4z"/><path fill="#188038" d="M0 195.4v40.4A20.2 20.2 0 0 0 20.2 256h40.4v-60.6z"/><path fill="#1967d2" d="M256 60.6V20.2A20.2 20.2 0 0 0 235.8 0h-40.4v60.6z"/><path fill="#fbbc04" d="M195.4 60.6H256v134.8h-60.6z"/><path fill="#34a853" d="M60.6 195.4h134.8V256H60.6z"/><path fill="#4285f4" d="M195.4 0H20.2A20.2 20.2 0 0 0 0 20.2v175.2h60.6V60.6h134.8z"/><path fill="#4285f4" d="M88.3 165.2c-5-3.4-8.5-8.4-10.4-14.9l11.6-4.9c2.1 8 7.1 12.7 15.2 12.7c8 0 14-5.1 14-12.3c0-8.3-6.6-12.5-15.3-12.5h-6.8v-11.6h6.1c8 0 13.3-4.2 13.3-11.3c0-6.3-4.6-10-12.1-10c-6.7 0-10.7 3.6-13 9.5l-11.6-4.8c3.3-9.5 11.6-15.8 24.3-15.8c15 0 25.2 8.5 25.2 20.7c0 8-4 13.6-10.3 17v.7c8 3.3 13.1 9.9 13.1 19.1c0 13.9-11.1 23.6-27 23.6c-5.9 0-11.3-1.7-16.3-5.2m71.8-58l-12.9 9.2l-6.4-9.7l23-16.6h8.9v78.3h-12.6z"/>',
  },
  slack: {
    body: '<path fill="#e01e5a" d="M53.8 161.3a26.8 26.8 0 1 1-26.8-26.8h26.8zm13.4 0a26.8 26.8 0 0 1 53.7 0v67.1a26.8 26.8 0 1 1-53.7 0z"/><path fill="#36c5f0" d="M94.1 53.6a26.8 26.8 0 1 1 26.8-26.8v26.8zm0 13.6a26.8 26.8 0 0 1 0 53.7H26.8a26.8 26.8 0 1 1 0-53.7z"/><path fill="#2eb67d" d="M201.6 94.1a26.8 26.8 0 1 1 26.8 26.8h-26.8zm-13.4 0a26.8 26.8 0 0 1-53.7 0V26.8a26.8 26.8 0 1 1 53.7 0z"/><path fill="#ecb22e" d="M161.3 201.6a26.8 26.8 0 1 1-26.8 26.8v-26.8zm0-13.4a26.8 26.8 0 0 1 0-53.7h67.3a26.8 26.8 0 1 1 0 53.7z"/>',
  },
};
const icon = icons[integration.slug];
const width = icon?.width ?? 256;
const height = icon?.height ?? 256;
---

<span
  class="connection-logo"
  role="img"
  aria-label={`${integration.label} connection`}
  style={`--connection-logo-size:${String(size)}px`}
  title={integration.label}
>
  {
    icon ? (
      <svg viewBox={`0 0 ${String(width)} ${String(height)}`} aria-hidden="true">
        <Fragment set:html={icon.body} />
      </svg>
    ) : (
      <span aria-hidden="true">{integration.label.slice(0, 1).toUpperCase()}</span>
    )
  }
</span>

<style>
  .connection-logo {
    display: inline-grid;
    width: var(--connection-logo-size);
    height: var(--connection-logo-size);
    flex: 0 0 auto;
    place-items: center;
    color: var(--color-ink-950);
    font: 750 0.66rem/1 var(--font-mono);
  }

  svg {
    width: var(--connection-logo-size);
    height: var(--connection-logo-size);
  }
</style>
