---
interface Props {
  href?: string;
}

const { href = "#top" } = Astro.props;
---

<a class="inline-flex items-center gap-2 font-mono text-[.82rem] font-extrabold tracking-[.08em] no-underline" href={href} aria-label="Crewhelm home">
  <img class="size-5" src="/crewhelm-mark.svg" width="20" height="20" alt="" aria-hidden="true" />
  <span aria-hidden="true">CREWHELM</span>
</a>
