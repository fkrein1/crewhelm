<div class="ledger-wrap" aria-label="Example Agent authority ledger">
  <div class="ledger-shadow" aria-hidden="true"></div>
  <article class="ledger-card">
    <header class="ledger-head">
      <div>
        <span class="micro-label">AUTHORITY LEDGER</span>
        <h3>research-brief</h3>
      </div>
      <span class="active-stamp">ACTIVE</span>
    </header>

    <div class="revision-line">
      <span>Agent revision</span>
      <code>rev_7c91a4</code>
      <span class="lock">IMMUTABLE</span>
    </div>

    <div class="decision-list">
      <div class="decision-row">
        <span class="decision-icon allowed" aria-hidden="true">✓</span>
        <div><strong>github.search_code</strong><small>Read scope · standing grant</small></div>
        <span class="ledger-decision allowed-text">ALLOWED</span>
      </div>
      <div class="decision-row emphasized">
        <span class="decision-icon approval" aria-hidden="true">!</span>
        <div><strong>slack.send_message</strong><small>External side effect · owner review</small></div>
        <span class="ledger-decision approval-text">APPROVAL</span>
      </div>
      <div class="decision-row">
        <span class="decision-icon denied" aria-hidden="true">×</span>
        <div><strong>github.delete_branch</strong><small>Destructive action · no grant</small></div>
        <span class="ledger-decision denied-text">DENIED</span>
      </div>
    </div>

    <div class="budget-block">
      <div class="budget-label"><span>Run budget</span><strong>18 / 50 steps</strong></div>
      <div class="budget-track" aria-label="18 of 50 run steps used"><span></span></div>
    </div>

    <footer class="receipt-footer">
      <div><span class="micro-label">RUN RECEIPT</span><strong>#0841 · COMPLETED</strong></div>
      <div><span class="micro-label">DISPATCH</span><strong>SINGLE · VERIFIED</strong></div>
      <span class="seal" aria-hidden="true">CH<br />✓</span>
    </footer>
  </article>
</div>
