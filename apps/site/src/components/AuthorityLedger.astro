---
const decisions = [
  {
    action: "github.search_code",
    detail: "Read scope · standing grant",
    icon: "✓",
    status: "ALLOWED",
    tone: "success",
  },
  {
    action: "slack.send_message",
    detail: "External side effect · owner review",
    emphasized: true,
    icon: "!",
    status: "APPROVAL",
    tone: "warning",
  },
  {
    action: "github.delete_branch",
    detail: "Destructive action · no grant",
    icon: "×",
    status: "DENIED",
    tone: "danger",
  },
] as const;

const tones = {
  danger: "border-danger text-danger bg-danger-soft",
  success: "border-success text-success bg-success-soft",
  warning: "border-warning text-warning bg-warning-soft",
};
---

<div class="relative ml-auto w-[83%] pt-5.5 pl-5.5 max-[900px]:w-[94%] max-[620px]:w-[calc(100%-7px)] max-[620px]:pt-2.5 max-[620px]:pl-2" aria-label="Example Agent authority ledger">
  <div class="absolute inset-[0_22px_22px_0] -rotate-2 border border-ink-400 bg-ink-200 max-[620px]:inset-[0_8px_10px_0]" aria-hidden="true"></div>
  <article class="relative border border-border-strong bg-card text-card-foreground shadow-ledger">
    <header class="flex min-h-29.5 items-start justify-between gap-6 border-b border-border-strong px-7.5 py-6.5 max-[620px]:min-h-25 max-[620px]:px-4.5 max-[620px]:py-5.5">
      <div>
        <span class="font-mono text-[.6rem] tracking-[.12em] text-muted-foreground">AUTHORITY LEDGER</span>
        <h3 class="mt-3.5 mb-0 text-[clamp(1.5rem,2.4vw,2.25rem)] tracking-[-.035em]">research-brief</h3>
      </div>
      <span class="rotate-2 border border-success px-2.5 py-1.5 font-mono text-[.6rem] font-extrabold tracking-[.1em] text-success">ACTIVE</span>
    </header>

    <div class="flex min-h-12 items-center gap-3 border-b border-border px-7.5 font-mono text-[.65rem] max-[620px]:px-4.5">
      <span class="text-muted-foreground">Agent revision</span>
      <code class="text-ink-700">rev_7c91a4</code>
      <span class="ml-auto font-extrabold tracking-[.06em] text-primary">IMMUTABLE</span>
    </div>

    <div class="px-5 py-3 max-[620px]:px-2.5">
      {decisions.map((decision) => (
        <div
          class:list={[
            "grid min-h-20 grid-cols-[34px_1fr_auto] items-center gap-3 border-b border-border px-3 py-3 last:border-b-0 max-[620px]:min-h-[91px] max-[620px]:grid-cols-[29px_1fr] max-[620px]:px-2",
            decision.emphasized && "-mx-5 bg-warning-soft px-7.5 max-[620px]:-mx-2.5 max-[620px]:px-4.5",
          ]}
        >
          <span class:list={["grid size-6 place-items-center rounded-full border font-mono text-[.72rem] font-extrabold", tones[decision.tone]]} aria-hidden="true">{decision.icon}</span>
          <div>
            <strong class="block font-mono text-[.78rem] leading-[1.3]">{decision.action}</strong>
            <small class="mt-1.5 block text-[.7rem] text-muted-foreground">{decision.detail}</small>
          </div>
          <span class:list={["border px-2 py-1.5 font-mono text-[.57rem] font-extrabold tracking-[.08em] max-[620px]:col-start-2 max-[620px]:justify-self-start", tones[decision.tone]]}>{decision.status}</span>
        </div>
      ))}
    </div>

    <div class="border-t border-border-strong px-7.5 pt-5.5 pb-6.5 max-[620px]:px-5">
      <div class="flex justify-between font-mono text-[.64rem] text-muted-foreground"><span>Run budget</span><strong class="text-foreground">18 / 50 steps</strong></div>
      <div class="mt-3 h-1.5 bg-ink-200" aria-label="18 of 50 run steps used"><span class="block h-full w-[36%] bg-primary"></span></div>
    </div>

    <footer class="grid min-h-23 grid-cols-[1fr_1fr_auto] items-center gap-6 border-t border-border-strong bg-paper-200 px-7.5 py-5 max-[620px]:grid-cols-[1fr_auto] max-[620px]:px-5 max-[620px]:[&>div:nth-child(2)]:hidden">
      <div><span class="font-mono text-[.6rem] tracking-[.12em] text-muted-foreground">RUN RECEIPT</span><strong class="mt-2 block font-mono text-[.67rem]">#0841 · COMPLETED</strong></div>
      <div><span class="font-mono text-[.6rem] tracking-[.12em] text-muted-foreground">DISPATCH</span><strong class="mt-2 block font-mono text-[.67rem]">SINGLE · VERIFIED</strong></div>
      <span class="grid size-12 -rotate-6 place-items-center rounded-full border border-primary font-mono text-[.62rem] leading-[1.15] font-extrabold text-primary" aria-hidden="true">CH<br />✓</span>
    </footer>
  </article>
</div>
