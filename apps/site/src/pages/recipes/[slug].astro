---
import RecipeDetail from "../../components/recipes/RecipeDetail.astro";
import RecipeHeader from "../../components/recipes/RecipeHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { recipePreviews } from "../../lib/recipe-catalog";

export const prerender = true;

export function getStaticPaths() {
  return recipePreviews.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
---

<SiteLayout title={`${recipe.title} — Crewhelm Recipe`} description={recipe.description}>
  <RecipeHeader />
  <main id="main" class="direct-recipe">
    <div class="direct-bar shell">
      <a href="/recipes/"><span aria-hidden="true">←</span> All Recipes</a>
    </div>
    <div class="shell detail-shell">
      <RecipeDetail {recipe} />
    </div>
  </main>
</SiteLayout>

<style>
  .direct-bar {
    display: flex;
    min-height: 4rem;
    align-items: center;
    font: 750 0.72rem/1 var(--font-mono);
  }

  .direct-bar a {
    text-underline-offset: 0.25rem;
  }

  .detail-shell {
    margin-bottom: 4rem;
    border: 1px solid var(--border-strong);
    padding: 0;
    box-shadow: var(--shadow-signal);
  }
</style>
