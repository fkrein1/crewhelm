---
import RecipeCatalog from "../../components/recipes/RecipeCatalog.astro";
import RecipeExplorer from "../../components/recipes/RecipeExplorer.astro";
import RecipeHeader from "../../components/recipes/RecipeHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { RECIPE_CATALOG_CACHE_CONTROL, toRecipePreview } from "../../lib/recipe-catalog";
import { listRegistryRecipes } from "../../lib/recipe-registry-server";

export const prerender = false;

const basePath = "/recipes";
let unavailable = false;
const recipes = await listRegistryRecipes(Astro.request)
  .then((items) => items.map(toRecipePreview))
  .catch(() => {
    unavailable = true;
    return [];
  });
Astro.response.headers.set(
  "cache-control",
  unavailable ? "no-store" : RECIPE_CATALOG_CACHE_CONTROL,
);
---

<SiteLayout
  title="Crewhelm Recipes — Ready-made Agent mandates"
  description="Browse Crewhelm Recipes by outcome, integration, capability, and model. Open a Recipe to inspect its boundaries and requirements."
>
  <RecipeHeader />
  <main id="main">
    <RecipeExplorer {basePath} {recipes}>
      <RecipeCatalog {recipes} {unavailable} />
    </RecipeExplorer>
  </main>
</SiteLayout>
