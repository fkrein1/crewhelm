---
import RecipeCatalog from "../../components/recipes/RecipeCatalog.astro";
import RecipeExplorer from "../../components/recipes/RecipeExplorer.astro";
import RecipeHeader from "../../components/recipes/RecipeHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { toRecipePreview } from "../../lib/recipe-catalog";
import {
  listPublicRegistryRecipes,
  listRegistryRecipes,
} from "../../lib/recipe-registry-server";

const previewBuild = import.meta.env.CLOUDFLARE_ENV === "preview";
const basePath = "/recipes";
let unavailable = false;
let recipes;
if (previewBuild) {
  recipes = (await listPublicRegistryRecipes()).map(toRecipePreview);
} else {
  recipes = await listRegistryRecipes(Astro.request)
    .then((items) => items.map(toRecipePreview))
    .catch(() => {
      unavailable = true;
      return [];
    });
}
if (!previewBuild) {
  Astro.response.headers.set(
    "cache-control",
    unavailable ? "no-store" : "public, max-age=30, s-maxage=300, stale-while-revalidate=600",
  );
}
---

<SiteLayout
  title="Crewhelm Recipes — Ready-made Agent mandates"
  description="Browse Crewhelm Recipes by outcome, integration, capability, and model. Open a Recipe to inspect its boundaries and requirements."
>
  <RecipeHeader />
  <main id="main">
    <RecipeExplorer {basePath} {recipes}>
      <RecipeCatalog {recipes} {unavailable} />
    </RecipeExplorer>
  </main>
</SiteLayout>
