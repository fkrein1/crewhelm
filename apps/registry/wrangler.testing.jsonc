{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crewhelm-registry-dev",
  "main": "src/testing.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": false },
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "REGISTRY_DB",
      "database_name": "crewhelm-registry-dev",
      "database_id": "67bae8bf-3ecf-4a8b-90f3-e2fb927e30e5",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "REGISTRY_PACKAGES", "bucket_name": "crewhelm-registry-packages-dev" },
  ],
  "vectorize": [{ "binding": "RECIPE_SEARCH_INDEX", "index_name": "crewhelm-recipe-search-dev" }],
  "ratelimits": [
    {
      "name": "PUBLIC_READ_RATE_LIMIT",
      "namespace_id": "21001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "SEARCH_RATE_LIMIT",
      "namespace_id": "21002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "PUBLISH_RATE_LIMIT",
      "namespace_id": "21003",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "GITHUB_CLIENT_ID": "testing-publisher-auth-disabled",
    "GITHUB_CLIENT_SECRET": "testing-publisher-auth-disabled",
    "PUBLIC_API_PREFIX": "/api/registry",
    "PUBLIC_ORIGIN": "https://crewhelm-registry-dev.fkrein.workers.dev/",
  },
  "triggers": { "crons": ["7 * * * *"] },
}
