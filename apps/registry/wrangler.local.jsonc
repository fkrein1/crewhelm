{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crewhelm-registry-local",
  "main": "src/local.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "REGISTRY_DB",
      "database_name": "crewhelm-registry-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "REGISTRY_PACKAGES", "bucket_name": "crewhelm-registry-local-packages" },
  ],
  "vars": {
    "PUBLIC_API_PREFIX": "/api/registry",
    "PUBLIC_ORIGIN": "http://127.0.0.1:8788/",
  },
}
